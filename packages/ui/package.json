{
  "name": "@geckolabs/elements",
  "version": "0.1.0-next.1",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/abstract": "0.3.2",
    "@dnd-kit/dom": "0.3.2",
    "@dnd-kit/react": "0.3.2",
    "@hugeicons/core-free-icons": "4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "frimousse": "^0.3.0",
    "input-otp": "^1.4.2",
    "motion": "^12.42.2",
    "react-colorful": "^5.6.1",
    "react-day-picker": "^9.11.1",
    "react-phone-number-input": "^3.4.14",
    "recharts": "^3.8.0",
    "shiki": "^4.0.2",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^25.1.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^17.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "shadcn": "^4.12.0",
    "@tailwindcss/node": "4.3.1",
    "@tailwindcss/oxide": "4.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "exports": {
    "./globals.css": "./dist/globals.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./charts": {
      "types": "./dist/charts.d.ts",
      "import": "./dist/charts.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "import": "./dist/lib/*.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "import": "./dist/hooks/*.js"
    },
    "./components/reply-box": {
      "types": "./dist/components/reply-box/index.d.ts",
      "import": "./dist/components/reply-box/index.js"
    },
    "./components/data-table": {
      "types": "./dist/components/data-table/index.d.ts",
      "import": "./dist/components/data-table/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./components/*.ts": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    }
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0",
    "react-is": "^18.3.1 || ^19.0.0"
  },
  "description": "Gecko Elements desktop React component library",
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "restricted",
    "tag": "next"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ]
}
