{
  "name": "gecko-elements",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test:data-table": "node scripts/test-data-table.mjs",
    "test:react-compat": "node scripts/test-react-compat.mjs",
    "test:message-scroller": "node tests/message-scroller/anchor-shift.mjs",
    "check:react-refs": "node scripts/check-react-refs.mjs",
    "build:package": "npm run build --workspace @geckolabs/elements",
    "test:package:tailwind": "ELEMENTS_CSS_MODE=tailwind node scripts/test-react-compat.mjs",
    "release:prepare": "node scripts/prepare-elements-release.mjs",
    "release:publish": "node scripts/publish-elements-release.mjs",
    "release:verify": "node scripts/publish-elements-release.mjs --verify-only",
    "generate:capabilities": "node scripts/generate-capabilities.mjs",
    "check:contracts": "node scripts/generate-capabilities.mjs --check && node scripts/check-application-contracts.mjs && node --test tests/application-recipes/contracts.test.mjs",
    "test:recipes": "tsc -p tests/application-recipes/tsconfig.json && node scripts/test-application-recipes.mjs",
    "test:rich-text-editor": "npm run build:package && node scripts/sync-rich-text-editor-assets.mjs && node --test tests/rich-text-editor/*.test.mjs && node scripts/test-application-recipes.mjs --rte"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.8.17",
    "typescript": "5.9.3",
    "playwright": "1.63.0",
    "react-is": "19.2.5"
  },
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "apps/projects/*",
    "packages/*"
  ]
}
